{
  "_doc": "Per-match layout variety data for the office (M2c). Spec: docs/design/levels/variety.md. Pure data, not imported yet: the tech-lead types MatchLayout, then the level generator (buildMatchLayout) reads this file. Grammar in variety.md section 3. World frame (office.md conventions): metres, north = -Z, east = +X; rot in degrees, Three.js rotation.y (kit fronts face local -Z). Desk keys are office.ts keys: '<block>.<row>.<column>' (block TL/TR/BL/BR, row N/S, column k from the west end). Walls, rooms, doors, glass, the 20 climb routes (17 stair/ramp routes + CO-B + 2 perches) and DELIBERATE_GAPS never change.",
  "format": 1,
  "mapId": "office",
  "look": {
    "stream": "look",
    "presets": [
      { "id": "day", "weight": 50, "baseline": true, "intent": "Today's look: cool white panels, every light on, bright and even." },
      { "id": "evening", "weight": 30, "intent": "Warm late-day tone, ambient a little lower, monitors glowing. Same lights on." },
      { "id": "afterHours", "weight": 20, "intent": "Most panels off, pools of light along the corridors and decks, monitors and exit pictograms glow. Tense, still readable." }
    ],
    "afterHours": {
      "litFraction": [0.35, 0.5],
      "unit": "lightPanel placements (ceiling props), chosen from stream 'look'",
      "everyAreaHasALitPanel": ["N corridor", "S corridor", "W corridor", "E corridor", "main aisle", "vertical aisle", "every enterable room", "every alcove"],
      "maxDistanceToLitPanel": 20
    },
    "fairness": {
      "simEffect": "none (bots and the sim ignore the look)",
      "outlinesAlwaysOn": true,
      "noPitchBlackFloor": true
    }
  },
  "fixedNote": "Everything in the M2b OFFICE that no zone, scatter or loot group below owns is fixed: walls and doorFrames (D1-D16, the closed front door), every climb-route piece (bookStairs, whiteboardRamps, CO-B tower, perch towers), the bridge desks and their under-bridge boxSmalls, the Corner Office exec desk with its monitor, keyboard and chair, the Yellow table with its chairs and laptop, phone booths, pinboard, ping pong and foosball tables, the Den, Gym, Paper Jam and Welcome Mat pieces, the pantry counter with its bottles and mugs, both vanities, the fire extinguishers and the ceiling (light panels, AC cassettes).",
  "deskBlocks": {
    "geometry": "office.md section 3: column pitch 12.64, row offset 3.395 from the spine, desks flush. Chairs at desk-local (jitter, -6.4), rot = desk rot + 180, with the M2b omissions and fixed-x rules (CHAIR_OMIT, CHAIR_FIXED_X, CHAIR_NO_EAST_JITTER).",
    "constraints": {
      "maxPodsPerMatch": 2,
      "order": ["TL", "TR", "BL", "BR"],
      "distinctPodX": [["TL", "BL"], ["TR", "BR"]],
      "distinctPodXRule": "If both blocks of a pair open a column at the same x, the later block (BL, BR) takes its other allowed column.",
      "podsOverCapRule": "A block that rolls 'pods' after the cap is reached re-rolls between 'rows' and 'gaps' (same stream)."
    },
    "blocks": [
      {
        "id": "TL",
        "anchors": ["TL.S.0", "TL.N.0", "TL.N.4", "TL.S.4"],
        "anchorWhy": "TL-A ramp lands on S0 (Kettle Corner), TL-C on N0, TL-B on N4; bridge N joins S4.",
        "variants": [
          { "id": "rows", "weight": 2, "baseline": true },
          { "id": "gaps", "weight": 2, "removeDesks": { "row": ["N", "S"], "columns": { "N": [1, 2, 3], "S": [1, 2, 3] }, "count": [1, 2] } },
          { "id": "pods", "weight": 1, "removeColumn": [1, 3], "atrium": "atriumCover" }
        ]
      },
      {
        "id": "TR",
        "anchors": ["TR.S.0", "TR.S.4", "TR.N.4", "TR.N.3"],
        "anchorWhy": "TR-A lands on S0 (and bridge N joins it), TR-B on S4, TR-C and the NE perch on N4; the perch route starts on N3.",
        "variants": [
          { "id": "rows", "weight": 2, "baseline": true },
          { "id": "gaps", "weight": 2, "removeDesks": { "row": ["N", "S"], "columns": { "N": [1, 2], "S": [1, 2, 3] }, "count": [1, 2] } },
          { "id": "pods", "weight": 1, "removeColumn": [1, 2], "atrium": "atriumCover" }
        ]
      },
      {
        "id": "BL",
        "anchors": ["BL.S.0", "BL.N.0", "BL.N.1", "BL.N.4"],
        "anchorWhy": "BL-A and BL-C land on S0, the SW perch stands on N0 and its route starts on N1, BL-B lands on N4 (bridge S joins it).",
        "variants": [
          { "id": "rows", "weight": 2, "baseline": true },
          { "id": "gaps", "weight": 2, "removeDesks": { "row": ["N", "S"], "columns": { "N": [2, 3], "S": [1, 2, 3] }, "count": [1, 2] } },
          { "id": "pods", "weight": 1, "removeColumn": [2, 3], "atrium": "atriumCover" }
        ]
      },
      {
        "id": "BR",
        "anchors": ["BR.N.0", "BR.N.5", "BR.S.5"],
        "anchorWhy": "BR-A lands on N0 (bridge S joins it), BR-B on N5, BR-C on S5.",
        "variants": [
          { "id": "rows", "weight": 2, "baseline": true },
          { "id": "gaps", "weight": 2, "removeDesks": { "row": ["N", "S"], "columns": { "N": [1, 2, 3, 4], "S": [1, 2, 3, 4] }, "count": [1, 2] } },
          { "id": "pods", "weight": 1, "removeColumn": [2, 3], "atrium": "atriumCover" }
        ]
      }
    ],
    "gapsRules": [
      "All removed desks of a block are in ONE row, so the other row keeps the deck in one piece (every route still reaches the whole deck).",
      "A removed desk takes its chair, monitor, keyboard, laptop and desk-top clutter with it. The tunnel under it stays (half covered), with its low cover.",
      "The hole is a 12.64 x 6.79 skylight: floor players see up, deck players see down. Nothing tall goes in it."
    ],
    "podsRules": [
      "Both desks of one middle column go, with their chairs, dressing and the tunnel's boxSmall and bookStack. The block becomes two pods with a 12.64 x 13.58 atrium between them.",
      "Each pod keeps at least one climb route (the allowed columns guarantee it).",
      "The atrium gets 'atriumCover' so it is not a clean north-south lane; it stays 3 m clear of the zone centre at the block's k2 tunnel."
    ],
    "atriumCover": {
      "frame": "origin = (column x, block spine), s = +1 or -1 from the block stream",
      "pieces": [
        { "kind": "box", "at": ["2.2s", "-5.0s"], "rot": 0 },
        { "kind": "boxSmall", "at": ["-1.535s", "-4.5s"], "rot": 0, "note": "flush against the box" }
      ]
    },
    "dressing": {
      "stream": "dress:<block>",
      "variants": [
        { "id": "plan", "weight": 1, "baseline": true, "patterns": { "TL": ["xx111", "Kx111"], "TR": ["1111P", "11111"], "BL": ["P1111", "11222"], "BR": ["221111", "211111"] } },
        { "id": "shuffled", "weight": 1, "rule": "Permute the '1' / '2' / 'x' codes among the block's desks that are not K or P (same counts per block)." }
      ],
      "deskClutter": {
        "note": "As M2b (office.md 3.3): 1-3 items per block desk, clear of loot (1 m) and route landings (1.5 m). Counts per match stay in these ranges so every deck keeps full-height cover.",
        "counts": { "box": [3, 5], "boxSmall": [5, 7], "plushSeal": [4, 6], "plushCrab": [4, 6], "plushWhale": [4, 6], "bookStack": [10, 14], "waterBottle": [12, 16], "mug": [16, 20] },
        "minFullCoverPerBlock": 3,
        "fullCoverKinds": ["box", "plushSeal", "plushCrab", "plushWhale", "laptop"]
      },
      "tunnelCover": {
        "note": "Per tunnel: one boxSmall and one bookStack at (x_k +- 2, spine +- 2.5), diagonal. The diagonal (s) and which corner gets which kind come from the block stream. The tunnel centre stays free for loot."
      }
    }
  },
